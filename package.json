{
  "name": "kargahyar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test tests/daily-production.test.ts",
    "test:db": "tsx --test tests/daily-production.db.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:demo": "tsx scripts/demo.ts",
    "auth:invite": "tsx scripts/invite.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
